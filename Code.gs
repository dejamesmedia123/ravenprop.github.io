function boot_runTests(){
  var ss=SpreadsheetApp.create('RAVEN-BOOT-TEST'),bad=[];
  function t(n,f){try{f();}catch(e){bad.push(n+': '+e.message);}}
  try{
    sheet_buildAll_(ss);
    t('trader signup',function(){var r=boot_signup({email:' A@Test.com ',password:'longenough1',ref:'ab-12'});util_assertEq_(r.role,'trader','role');util_assert_(/^U-/.test(r.user_id),'id');});
    t('stored clean',function(){var u=sheet_findOne('Users',{email:'a@test.com'});util_assert_(u&&u.ref_used==='AB12'&&u.password_hash.indexOf('pbkdf2')===0&&u.role==='trader','row');});
    t('duplicate refused',function(){util_assertThrows_(function(){boot_signup({email:'a@test.com',password:'longenough1'});},'dup');});
    t('bad email/password',function(){util_assertThrows_(function(){boot_signup({email:'x',password:'longenough1'});},'e');util_assertThrows_(function(){boot_signup({email:'b@test.com',password:'short'});},'p');});
    t('signups closed',function(){sheet_updateRow('Settings','signup_enabled',{value:'false'});util_assertThrows_(function(){boot_signup({email:'c@test.com',password:'longenough1'});},'closed');sheet_updateRow('Settings','signup_enabled',{value:'true'});});
    t('key guard',function(){var pr=PropertiesService.getScriptProperties();if(pr.getProperty('SETUP_KEY')||pr.getProperty('BOOTSTRAP_OPEN'))return;util_assertThrows_(function(){boot_checkKey_('x');},'refuse without key/switch');});
  }finally{sheet_setSpreadsheet_(null);try{DriveApp.getFileById(ss.getId()).setTrashed(true);}catch(e){}}
  if(bad.length)throw new Error('Failed: '+bad.join(' | '));
  console.log('ALL PART 4 TESTS PASSED');
}
