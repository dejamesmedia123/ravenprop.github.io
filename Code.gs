function sheet_migrate(){var r=sheet_buildAll_();if(typeof settings_clear_==="function")settings_clear_();console.log("sheet_migrate: "+JSON.stringify(r));return r;}
// ===== PART 4: FIRST SIGN-UP BOOTSTRAP =====
// Prefix boot_. 'auth.signup' points at boot_signup until Part 6 wraps it.
// First sign-up needs SETUP_KEY (Script Property) or BOOTSTRAP_OPEN='true'; else refused.
function boot_prop_(k){return PropertiesService.getScriptProperties().getProperty(k)||'';}
function boot_setting_(k,d){try{var r=sheet_getByKey('Settings',k);return r&&r.value!==''&&r.value!==null?String(r.value):d;}catch(e){return d;}}
function boot_err_(m){return util_error_(CODES.BAD_REQUEST,m);}
function boot_checkKey_(given){
  var key=boot_prop_('SETUP_KEY');
  if(key){if(!util_safeEqual_(String(given||''),key))throw util_error_(CODES.FORBIDDEN,'A valid setup key is required.');}
  else if(boot_prop_('BOOTSTRAP_OPEN')!=='true')throw util_error_(CODES.NOT_SETUP,'The system is not set up yet.');
}
// Only the owner account may open the spreadsheet (it holds MT5 passwords).
function boot_lockDown_(ss){
  try{
    var f=DriveApp.getFileById(ss.getId()),me=Session.getEffectiveUser().getEmail();
    f.setSharing(DriveApp.Access.PRIVATE,DriveApp.Permission.NONE);
    f.getEditors().forEach(function(u){if(u.getEmail()!==me)f.removeEditor(u);});
    f.getViewers().forEach(function(u){f.removeViewer(u);});
  }catch(e){console.error('boot_lockDown_: '+e);}
}
function boot_signup(p,ctx){
  p=p||{};
  var email=util_normalizeEmail_(p.email);
  if(!email)throw boot_err_('Enter a valid email address.');
  var pv=util_validatePassword_(p.password,Number(boot_setting_('password_min_length',8))||8);
  if(!pv.ok)throw boot_err_(pv.error);
  var phone=p.phone?util_normalizePhone_(p.phone):'';
  if(p.phone&&!phone)throw boot_err_('Enter a valid phone number.');
  var country=p.country?util_normalizeCountry_(p.country):'';
  if(p.country&&!country)throw boot_err_('Enter a valid country.');
  var ref=String(p.ref||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,20);
  var name=String(p.full_name||'').trim().slice(0,100);
  var hash=util_hashPassword_(p.password); // slow: done before taking the lock
  var ip=String(p.client_ip||'').trim(); // the address the browser reports (Apps Script cannot see it); used only for the affiliate self-referral check
  if(!/^[0-9a-fA-F:.]{3,45}$/.test(ip))ip='';
  return util_withLock_(function(){
    var first=!sheet_isSetup_(),ss=null;
    if(first){
      boot_checkKey_(p.setup_key);
      ss=SpreadsheetApp.create('Raven Prop Data');
      try{sheet_buildAll_(ss);}catch(e){sheet_setSpreadsheet_(null);try{DriveApp.getFileById(ss.getId()).setTrashed(true);}catch(x){}throw e;}
    }else{
      if(boot_setting_('maintenance_mode','false')==='true')throw util_error_(CODES.BUSY,'We are under maintenance. Please try again later.');
      if(boot_setting_('signup_enabled','true')==='false')throw util_error_(CODES.FORBIDDEN,'Sign-ups are closed right now.');
      if(sheet_findOne('Users',{email:email}))throw boot_err_('This email is already registered.');
    }
    try{
      var now=util_nowIso_(),role=first?'owner':'trader';
      var u=sheet_appendRow('Users',{user_id:sheet_newKey_('Users'),email:email,phone:phone,full_name:name,password_hash:hash,
        role:role,status:'active',country:country,ref_used:ref,signup_ip:ip,failed_logins:0,created_at:now,updated_at:now});
      if(ref&&!first&&typeof aff_onSignup==='function')aff_onSignup(u); // Part 15: count the sign-up (never throws)
      if(first){
        PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());
        PropertiesService.getScriptProperties().deleteProperty('SETUP_KEY');
        boot_lockDown_(ss);
      }
      return {user_id:u.user_id,role:role};
    }catch(e){
      if(first&&!boot_prop_('SPREADSHEET_ID')){sheet_setSpreadsheet_(null);try{DriveApp.getFileById(ss.getId()).setTrashed(true);}catch(x){}}
      throw e;
    }
  });
}
